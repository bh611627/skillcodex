{
  "name": "@skillcodex/skills",
  "version": "1.1.1",
  "description": "AI agent skills and reusable workflows for React & Next.js - curated SKILL.md library for Cursor, Claude Code, and automation tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./accessibility-audit": {
      "types": "./dist/skills/accessibility-audit.d.ts",
      "import": "./dist/skills/accessibility-audit.js"
    },
    "./code-assistant": {
      "types": "./dist/skills/code-assistant.d.ts",
      "import": "./dist/skills/code-assistant.js"
    },
    "./content-creator": {
      "types": "./dist/skills/content-creator.d.ts",
      "import": "./dist/skills/content-creator.js"
    },
    "./database-schema-agent": {
      "types": "./dist/skills/database-schema-agent.d.ts",
      "import": "./dist/skills/database-schema-agent.js"
    },
    "./env-config-agent": {
      "types": "./dist/skills/env-config-agent.d.ts",
      "import": "./dist/skills/env-config-agent.js"
    },
    "./performance-audit": {
      "types": "./dist/skills/performance-audit.d.ts",
      "import": "./dist/skills/performance-audit.js"
    },
    "./seo-agent": {
      "types": "./dist/skills/seo-agent.d.ts",
      "import": "./dist/skills/seo-agent.js"
    },
    "./skill-creator": {
      "types": "./dist/skills/skill-creator.d.ts",
      "import": "./dist/skills/skill-creator.js"
    },
    "./skillcodex-browser-ui": {
      "types": "./dist/skills/skillcodex-browser-ui.d.ts",
      "import": "./dist/skills/skillcodex-browser-ui.js"
    },
    "./testing-agent": {
      "types": "./dist/skills/testing-agent.d.ts",
      "import": "./dist/skills/testing-agent.js"
    },
    "./typescript-refactor": {
      "types": "./dist/skills/typescript-refactor.d.ts",
      "import": "./dist/skills/typescript-refactor.js"
    },
    "./web-design-guidelines": {
      "types": "./dist/skills/web-design-guidelines.d.ts",
      "import": "./dist/skills/web-design-guidelines.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "skills-index.json"
  ],
  "scripts": {
    "build": "tsc",
    "sync": "tsx src/sync.ts",
    "validate": "tsx src/validate.ts",
    "prebuild": "tsx src/sync.ts"
  },
  "keywords": [
    "ai-agents",
    "ai-agent-skills",
    "agent-skills",
    "cursor-skills",
    "claude-code",
    "skills-sh",
    "skill-md",
    "workflows",
    "developer-tools",
    "developer-productivity",
    "automation",
    "nextjs",
    "react",
    "typescript",
    "skillcodex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bh611627/skillcodex.git"
  },
  "homepage": "https://github.com/bh611627/skillcodex#readme",
  "bugs": {
    "url": "https://github.com/bh611627/skillcodex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.0.0",
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
